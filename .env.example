# --- Keitaro ---
# Адрес трекера без /admin_api/v1
KEITARO_URL=https://your-tracker.example.com
# Admin API ключ: Keitaro -> Профиль -> API ключи
KEITARO_API_KEY=

# id по умолчанию для «создаватора» (можно оставить пустыми и выбирать в форме)
KEITARO_DEFAULT_DOMAIN_ID=
KEITARO_DEFAULT_GROUP_ID=
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=

# Как собирать поток «гео -> гугл» и поток с офферами.
# Сверить со своей версией Keitaro: uv run python -m tools.check_keitaro
REDIRECT_URL=https://google.com
REDIRECT_ACTION_TYPE=http
COUNTRY_FILTER_NAME=country
OFFERS_STREAM_SCHEMA=landings
OFFERS_STREAM_ACTION_TYPE=http

# --- База ---
# SQLite по умолчанию; Postgres: postgresql+psycopg://user:pass@localhost:5432/adrobot
DATABASE_URL=sqlite:///./adrobot.db
